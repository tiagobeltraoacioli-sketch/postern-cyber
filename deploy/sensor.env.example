POSTERN_SERVER=https://console.example.com
# Needed on first start only; remove after the sensor has enrolled.
POSTERN_ENROLL_TOKEN=pce_...
POSTERN_STATE_DIR=/var/lib/postern-sensor
# Empty = observe only. Grant any of: kill,quarantine,isolate
POSTERN_RESPONSE=
# Addresses that stay reachable while the host is isolated (your admin jump host).
POSTERN_ISOLATE_ALLOW=
